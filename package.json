{
  "name": "alphalpha-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alphalpha chief-of-staff dashboard for open loops, projects, digests, and investing research.",
  "scripts": {
    "generate:data": "node scripts/generate-dashboard-data.mjs",
    "generate:data:snapshot": "node scripts/generate-dashboard-data.mjs --snapshot",
    "dev": "NODE_ENV=development npm run generate:data && NODE_ENV=development next dev",
    "build": "npm run generate:data && next build",
    "start": "next start",
    "lint": "next lint",
    "test:auth": "npx tsx scripts/auth.test.ts",
    "test": "vitest run",
    "almanac:evaluate": "node scripts/evaluate-almanac-novelty.mjs",
    "almanac:bakeoff": "node scripts/compare-almanac-providers.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "jose": "^5.10.0",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "vitest": "^4.1.7"
  }
}
